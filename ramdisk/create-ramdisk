#!/bin/bash
if [ -z "$1" ]; then
	MAX_SIZE='8G'
else
	MAX_SIZE=$1
fi

mkdir -p /dev/shm/ramdisk

if sudo mount -t tmpfs -o size="$MAX_SIZE" tmpfs /dev/shm/ramdisk; then
	ln -sf /dev/shm/ramdisk ~/.ramdisk
	touch /dev/shm/ramdisk/.symlinks
	echo -e "\033[1;32mSUCCESS\033[0m: ramdisk is enabled"
else
	rm -rf /dev/shm/ramdisk
	if [[ -L ~/.ramdisk ]]; then
		rm ~/.ramdisk
	fi
fi


